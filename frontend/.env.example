# Local: point straight at the API.
# Vercel: NEXT_PUBLIC_API_URL=/api (same-site, proxied) and BACKEND_ORIGIN=<API origin>,
#         NEXT_PUBLIC_SOCKET_URL=<API origin> (WebSockets can't go through the proxy).
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Huddles (WebRTC). STUN defaults to stun:stun.l.google.com:19302.
# TURN is optional; comma-separate several URLs.
NEXT_PUBLIC_STUN_URL=
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Server-side only (Vercel): where /api/* is proxied to, e.g. https://workspace-api-xxxx.onrender.com
BACKEND_ORIGIN=
