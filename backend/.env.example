NODE_ENV=development
PORT=5000
# One or more origins, comma-separated; the first is used in email links
CLIENT_URL=http://localhost:3000

MONGO_URI=mongodb://localhost:27017/org-comm

SESSION_SECRET=replace_with_a_long_random_string
SESSION_TTL_DAYS=7
COOKIE_NAME=sid
# Lax locally; None when the frontend and API are on different sites (Render + Vercel)
COOKIE_SAMESITE=Lax

# Express 'trust proxy': unset/false locally; e.g. 1 behind one reverse proxy
TRUST_PROXY=

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=your_email@example.com

MAX_UPLOAD_BYTES=26214400

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Production email over HTTPS (Gmail API, scope gmail.send). When all three are
# set they are used instead of SMTP - needed where SMTP ports are blocked
# (e.g. Render free). Refresh token from the OAuth Playground; in Google's
# "Testing" publishing status it expires after 7 days.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
